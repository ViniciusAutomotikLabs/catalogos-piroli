# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# NUNCA commite chaves reais. Este arquivo contém apenas placeholders.

# --- App web (Next.js) ---
# Variáveis públicas (expostas ao browser). Use a URL do projeto e a chave publishable/anon.
# Valores reais ficam no .env (ignorado pelo git), não aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Catálogo TecDoc (PostgREST na VPS) — apenas server-side, sem senha do Postgres
# TECDOC_API_URL=http://31.97.93.135:3005

# --- ERP 2.0: criptografia de coluna (server-side; secret do Coolify) ---
# Gere cada uma com: openssl rand -base64 32  (32 bytes / 256 bits)
# NUNCA exponha com NEXT_PUBLIC_ e NUNCA guarde no mesmo Postgres dos dados.
# ERP_ENCRYPTION_KEY=base64-de-32-bytes-aqui
# ERP_BLIND_INDEX_KEY=base64-de-32-bytes-aqui

# --- ERP 2.0: módulo de IA (Ollama no DGX via Tailscale; server-side) ---
# OLLAMA_BASE_URL=http://100.x.y.z:11434
# OLLAMA_MODEL=llama3.1
# Medição de tokens (débito no ledger) e escritas privilegiadas usam a service_role.
# SERVER-ONLY: nunca prefixe com NEXT_PUBLIC_. Necessária p/ o módulo de IA contabilizar.
# SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# --- Pipeline de ingestão (backend/Python) — NÃO usar no app web ---
# Mantenha estas variáveis apenas em ambientes de servidor/CI. Nunca prefixe com NEXT_PUBLIC_.
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui


# --- Parâmetros de storage/imagem do pipeline (opcionais) ---
# STORAGE_QUOTA_MB=50
# STORAGE_MB_POR_CATALOGO=0.45
# IMAGE_MAX_SIDE=640
# IMAGE_JPEG_QUALITY=72
# IMAGE_TARGET_MAX_KB=85
# MVP_MAX_IMAGENS_POR_CATALOGO=0
# MVP_PULAR_CONCLUIDOS=true
